{
  "id": "admaps-browser",
  "title": "ADMaps Browser",
  "description": "Browse ADMaps maps, NPC tokens and backdrops from admaps.cloud right inside Foundry and download them into your world: the files go into Data, a map's scene is imported with its variations. Sign in with your ADMaps account to see what you can download.",
  "version": "0.1.4",
  "compatibility": {
    "minimum": "12",
    "verified": "14"
  },
  "authors": [
    {
      "name": "ADMaps",
      "url": "https://admaps.cloud/"
    }
  ],
  "url": "https://github.com/admapscloud/admaps-browser",
  "manifest": "https://github.com/admapscloud/admaps-browser/releases/latest/download/module.json",
  "download": "https://github.com/admapscloud/admaps-browser/releases/download/v0.1.4/admaps-browser.zip",
  "bugs": "https://github.com/admapscloud/admaps-browser/issues",
  "readme": "https://github.com/admapscloud/admaps-browser/blob/main/README.md",
  "changelog": "https://github.com/admapscloud/admaps-browser/blob/main/CHANGELOG.md",
  "license": "LICENSE",
  "persistentStorage": true,
  "esmodules": [
    "scripts/main.mjs"
  ],
  "styles": [
    "styles/browser.css"
  ],
  "languages": [
    { "lang": "en", "name": "English", "path": "lang/en.json" },
    { "lang": "cn", "name": "中文（简体）", "path": "lang/cn.json" },
    { "lang": "fr", "name": "Français", "path": "lang/fr.json" },
    { "lang": "de", "name": "Deutsch", "path": "lang/de.json" },
    { "lang": "it", "name": "Italiano", "path": "lang/it.json" },
    { "lang": "ja", "name": "日本語", "path": "lang/ja.json" },
    { "lang": "ko", "name": "한국어", "path": "lang/ko.json" },
    { "lang": "pl", "name": "Polski", "path": "lang/pl.json" },
    { "lang": "pt-BR", "name": "Português (Brasil)", "path": "lang/pt-BR.json" },
    { "lang": "ru", "name": "Русский", "path": "lang/ru.json" },
    { "lang": "es", "name": "Español", "path": "lang/es.json" },
    { "lang": "uk", "name": "Українська", "path": "lang/uk.json" }
  ]
}
